# Environment configuration template for Colibri.
#
# Copy this file to one of the (git-ignored) flavor files and fill in values:
#   .env.dev          (development)
#   .env.staging      (staging)
#   .env.production   (production)
#
# Then run/build with the matching flavor file, e.g.:
#   flutter run   --dart-define-from-file=.env.dev
#   flutter build apk --dart-define-from-file=.env.production
#
# Never commit real secrets. `.env` and `.env.*` are git-ignored; only this
# `.env.example` is tracked.

# Active flavor: dev | staging | production
APP_ENV=dev

# Supabase (Phase 1). Tolerated empty in dev (the placeholder app still boots);
# required in staging/production, where a missing value fails fast in main().
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sentry crash reporting (Phase 15). Optional during early development.
SENTRY_DSN=

# Analytics toggle (Phase 15). Keep disabled in dev.
ANALYTICS_ENABLED=false
